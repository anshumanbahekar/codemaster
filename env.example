# ─────────────────────────────────────────────────────────────────────────────
#  codemaster — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API — get free key at https://console.anthropic.com
# Powers all 6 AI agents (lesson, snippet gen, coach, battle AI, error explainer, review)
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Firebase — get from https://console.firebase.google.com
# Project Settings → Your apps → Web app → Config
VITE_FIREBASE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxxxx
